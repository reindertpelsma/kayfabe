=== ★★★ (a) BAR0 + 0x88084 — the word RM decodes ===
BAR0+0x88084 = 0x00000000   NV_XVE_LINK_CAPABILITIES   (RM reads THIS for PCIE_GPU_LINK_CAPS)
    MAX_SPEED(3:0) = 0  ★ ILLEGAL — this is the 'Unknown PCIe speed' that returns 0x40
    MAX_WIDTH(9:4) = 0 lanes
BAR0+0x88088 = 0x00000000   NV_XVE_LINK_CONTROL_STATUS
BAR0+0x88000 = 0x00000000   NV_XVE_ID (vendor/device)
BAR0+0x88078 = 0x00000000   NV_XVE_DEVICE_CONTROL_STATUS
