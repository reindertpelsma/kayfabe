+/* #13 (2026-07-05): a write landing on a tracked GR-VAS page-table page means a mapping
+ * changed -> arm a re-sweep for the next doorbell (identical intent to the nvkvm_fb_write
+ * hook, factored out so the CE bulk-copy data path can call it too).  The lo/hi range
+ * rejects the common data write in two compares before the hash confirms.  The guest RM
+ * populates page tables by CE COPY (bulk memcpy fb->fb, which BYPASSES nvkvm_fb_write), so
+ * without this a fresh mapping written via CE never sets the dirty flag, the gated re-sweep
+ * skips it, and the newly-mapped buffer page is left unbacked in the host GR VAS -> the host
+ * GR engine FAULT_PDEs on it (#13: cup8_iter N=1536 iter-2 matmul dst one 2 MiB page past the
+ * last-backed gpga).  Marking dirty here makes the launch doorbell re-sweep and back it. */
+static inline void nvkvm_m2_gr_pt_touch(NvkvmGpuEmul *s, uint64_t fb_addr)
+{
+    if (s->m2_gr_pt_n && !s->m2_gr_vas_dirty &&
+        fb_addr >= s->m2_gr_pt_lo && fb_addr <= s->m2_gr_pt_hi + 0xfffull &&
+        nvkvm_m2_gr_pt_contains(s, fb_addr)) {
+        s->m2_gr_vas_dirty = true;
+    }
+}
 
