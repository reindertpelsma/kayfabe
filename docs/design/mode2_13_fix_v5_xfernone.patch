+/* #13 FIX — sync the host GR VAS BEFORE a CPU-emulated CE semaphore release.
+ *
+ * The guest's compute submissions are ordered against its map/unmap pushes by
+ * GPU-side semaphores: the (already-rung, host-resident) GR channel sits in a
+ * SEM ACQUIRE until the UVM/RM map push's CE release fires.  We emulate those
+ * map pushes on the CPU (chan_execute), so the release is OUR write — and the
+ * moment we write it, the real host GPU proceeds into the compute op.  The
+ * map push's page-table writes land only in the emulated FB shadow; nothing
+ * re-synced the persistent host GR VAS between those writes and the release
+ * (the deferred sweep is doorbell-driven, and the guest's LAST doorbell can
+ * precede the map push's execution — trace-proven in cup8_iter iter-2: GR ring
+ * @115..119, PT rebuild lands later, sweep never re-runs, host CE FAULT_PDE one
+ * page past the last-backed leaf, Xid 31).  So: when this parse wrote a tracked
+ * GR-VAS page-table page (m2_gr_vas_dirty, armed by the CE-copy dst check the
+ * same way nvkvm_fb_write arms it), run the compute-VAS backing sweep NOW,
+ * before the release is observable.  enum_gr_sysmem is idempotent (va_seen
+ * dedup), so this consumes the dirty flag a few doorbells early at worst. */
+static void nvkvm_m2_pt_sync_before_sema(NvkvmGpuEmul *s)
+{
+    if (s->m2_gr_vas_dirty && s->m2exec && s->m2_gr_client) {
+        s->m2_gr_vas_dirty = false;     /* consume; a later PT write re-arms */
+        qemu_log("nvkvm-gpu[%s] #13 pre-sema PT-sync sweep (client=0x%08x)\n",
+                 s->chip->name, s->m2_gr_client);
+        nvkvm_m2_enum_gr_sysmem(s, s->m2_gr_client);
+    }
+}
