/traces/cl*
/traces/dia*

# --- everything .gitignore ignores (kept line for line) ---
/target
/target-*
/crates/kayfabe-abi/gen/target
/firmware/*/target
/firmware/**/*.efi
**/Cargo.lock.orig
/mutants.out
/mutants.out.old
/mutants_fwdmmu
/mutants_triage
/docs/design/*.pdf
/docs/design/*.png
**/__pycache__
/docs/whitepaper/*.aux
/docs/whitepaper/*.log
/docs/whitepaper/*.out
/docs/whitepaper/*.toc
/.deadman/beat
**/.w753
**/.wrangler

# --- repository metadata: the box needs a git directory, but it is not part of a result key ---
/.git
**/.gitignore
/.workerignore

# --- trees a box never reads ---
/archive
/site
/.github
/.deadman

# --- repository notices and markers: read only by packaging and by documents ---
# LICENSE* (the three notice files and any later one, like the gate's own `LICENSE*` skip pattern): scripts/bench/windows/appmatrix/package_bundle.py copies them into the Windows app bundle
# (CI runner, bundle-publish.yml, full tree; it already reads THIRD_PARTY_NOTICES.md, which `**/*.md`
# below ignores). KAYFABE_REV.txt: read by no code, only cited by documents.
/LICENSE*
/KAYFABE_REV.txt

# --- reference submodules no GPU-free test needs (they are uninitialised empty directories) ---
# third_party/ogkm and third_party/ogkm-580 stay: tools/derive_hwref.sh and the oracle tests read them.
/third_party/linux
/third_party/gvisor

# --- prose (an exception, if one is found, is listed in the evidence README) ---
**/*.md

# --- Cloudflare Worker code and its tests: run by CI on the runner, never on a box ---
/ci/platform-api
/ci/vast-admin
/ci/vast-broker
/ci/vast-reaper

# --- local test and gate scripts the box payload does not run ---
/scripts/ci/test_*.py
/scripts/ci/*_mutants.py
/scripts/ci/clippy.sh
/scripts/ci/*-debt.json
/scripts/ci/gpu-uuids-baseline.json
/scripts/ci/cloud_init_replay.py
/scripts/ci/debt.py
/scripts/ci/dependencies.py
/scripts/ci/doc_freshness.py
/scripts/ci/doc_status_check.py
/scripts/ci/no_gpu_uuids.py
/scripts/ci/no_private_refs.py
/scripts/ci/runner_namespaces.py
/scripts/ci/workflow_lint.py
/scripts/bench/tests
/scripts/mutate
/scripts/ci_gates.sh
/scripts/claim_ledger.py
/scripts/check_archive_citations.sh
/scripts/check_v3_isolation.sh
/scripts/build_arch_pdf.sh
/scripts/build_arch_pdf_v3.sh
/scripts/fair_mutation_check.py
/scripts/lazy_mutation_check.py
/scripts/lifecycle_mutation_check.sh
/scripts/v2_mutation_check.py

