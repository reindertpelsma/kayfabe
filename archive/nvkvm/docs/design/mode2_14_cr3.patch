+                 tsys ? "sys" : "fb", (unsigned long long)pde);
+        if ((pde & 1) && i == 2) { return; }        /* 512M leaf: walk succeeds */
+        uint32_t ap = (uint32_t)((pde >> 1) & 0x3);
+        if (ap == 1) { tbl = ((pde >> 8) & ((1ull << 25) - 1)) << 12; tsys = false; }
+        else if (ap == 2 || ap == 3) { tbl = ((pde >> 8) & ((1ull << 46) - 1)) << 12; tsys = true; }
+        else { return; }
