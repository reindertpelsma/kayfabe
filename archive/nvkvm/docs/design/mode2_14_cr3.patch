diff --git a/src/qemu/nvkvm_cpukey.c b/src/qemu/nvkvm_cpukey.c
new file mode 100644
index 0000000..f484c21
--- /dev/null
+++ b/src/qemu/nvkvm_cpukey.c
@@ -0,0 +1,49 @@
+/*
+ * nvkvm_cpukey.c — per-target helper: read the executing vCPU's guest CR3.
+ *
+ * #14 per-guest-process isolation (docs/design + memory mode2_isolation_cr3_key):
+ * the guest process identity visible to QEMU at a trapping MMIO/PIO access is the
+ * vCPU's CR3 (the guest address space).  Two concurrent guest CUDA processes are
+ * indistinguishable by RM handle / guest VA (the stock driver hands both identical
+ * VAs and identical handle values), but their page directories differ — CR3 at the
+ * trapping write is the only authoritative process key.
+ *
+ * This lives in its own file because nvkvm_gpu_emul.c is built target-independent
+ * (system_ss) where X86CPU/env are poisoned; this file is added to specific_ss so
+ * it compiles with the target's cpu.h.
+ *
+ * Under KVM the QEMU-side register cache is stale until synchronized;
+ * cpu_synchronize_state() is the canonical fetch (same pattern as hw/i386/vapic.c)
+ * and is a no-op when the state is already dirty.  Callers are on the vCPU thread
+ * (MMIO trap handlers), where this is valid and race-free.
+ *
+ * Returned value: raw CR3 with the PCID/low bits and the PCID-noflush bit (63)
+ * masked, i.e. the page-directory base.  NOTE deliberately NOT masking bit 12:
+ * with KPTI the kernel/user halves of one process differ in bit 12 (order-1 PGD
+ * pair), but without KPTI two distinct processes' PGDs can be adjacent 4 KiB
+ * pages — masking would alias them.  Callers must treat "differs only in bit 12"
+ * as possibly-same-process if they ever key user-mode traps (KPTI); all current
+ * call sites trap from guest-kernel context (driver code), one CR3 per process.
+ *
+ * 0 = no executing vCPU (device reset / monitor / callback context).
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "sysemu/hw_accel.h"
+
+uint64_t nvkvm_current_guest_cr3(void);
+
+uint64_t nvkvm_current_guest_cr3(void)
+{
+#ifdef TARGET_I386
+    CPUState *cs = current_cpu;
+    if (!cs) {
+        return 0;
+    }
+    cpu_synchronize_state(cs);
+    return X86_CPU(cs)->env.cr[3] & 0x7ffffffffffff000ull;
+#else
+    return 0;
+#endif
+}
