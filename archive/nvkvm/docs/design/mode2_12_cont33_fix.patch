@@ -6817,8 +6973,14 @@ static bool nvkvm_m2_back_and_map_sys(NvkvmGpuEmul *s, uint32_t client, uint64_t
              "os_st=0x%x map rc=%d st=0x%x %s\n", s->chip->name, (unsigned long long)va,
