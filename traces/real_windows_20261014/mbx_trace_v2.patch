diff --git a/tools/windows-capture/lib/kfwc_engine.c b/tools/windows-capture/lib/kfwc_engine.c
index 3b766afb4..34aff867f 100644
--- a/tools/windows-capture/lib/kfwc_engine.c
+++ b/tools/windows-capture/lib/kfwc_engine.c
@@ -654,6 +654,14 @@ static void note_mailbox_signature(kfwc_engine *e, const kfwc_mb_diag *diag)
 {
     if (e->mb_sig_seen && (e->mb_sig_status != diag->status || e->mb_sig_pa != diag->mailbox_pa)) {
         e->stats.scan_backoff_resets++;
+        {   /* DIAGNOSTIC VARIANT (mbx-trace): one event per mailbox signature change; reads only */
+            kfwc_u8 t[24];
+            memset(t, 0, sizeof(t));
+            kfwc_put32(t + 0, diag->status);
+            kfwc_put64(t + 8, diag->mailbox_pa);
+            kfwc_put64(t + 16, now_ticks(e));
+            ev_push(e, 5u, t, sizeof(t));
+        }
         scan_backoff_restart(e);
     }
     e->mb_sig_seen = 1;
@@ -755,6 +763,27 @@ kfwc_u32 kfwc_engine_step(kfwc_engine *e)
         poll_dir(e, KFWC_DIR_CMD, &emitted);
         if (e->state == KFWC_ST_ATTACHED)
             poll_dir(e, KFWC_DIR_STAT, &emitted);
+        if (e->cfg.use_mailbox && (e->tw_last == 0 || now_ticks(e) - e->tw_last >= e->cfg.mailbox_period_ticks)) {
+            /* DIAGNOSTIC VARIANT (mbx-trace): while attached, keep reading the two whitelisted
+             * mailbox registers every 10 ms and log each change of the raw pair (event 6). */
+            kfwc_u32 lo = 0, hi = 0;
+            kfwc_u64 t0 = now_ticks(e);
+            int bad = kfwc_reg_read(&e->plat, KFWC_REG_GSP_MAILBOX0, &lo) ||
+                      kfwc_reg_read(&e->plat, KFWC_REG_GSP_MAILBOX1, &hi);
+            kfwc_u64 pair = bad ? ~0ull : (((kfwc_u64)hi << 32) | lo);
+            e->tw_last = t0 ? t0 : 1;
+            e->stats.mailbox_reads++;
+            if (!e->tw_seen || pair != e->tw_pair) {
+                kfwc_u8 t[24];
+                memset(t, 0, sizeof(t));
+                kfwc_put32(t + 0, bad);
+                kfwc_put64(t + 8, pair);
+                kfwc_put64(t + 16, t0);
+                ev_push(e, 6u, t, sizeof(t));
+                e->tw_pair = pair;
+                e->tw_seen = 1;
+            }
+        }
     }
 out:
     e->stats.state = e->state;
diff --git a/tools/windows-capture/lib/kfwc_engine.h b/tools/windows-capture/lib/kfwc_engine.h
index 0808cf341..dea681c17 100644
--- a/tools/windows-capture/lib/kfwc_engine.h
+++ b/tools/windows-capture/lib/kfwc_engine.h
@@ -123,6 +123,8 @@ typedef struct kfwc_engine {
     kfwc_u64 scan_backoff_cur;      /* pause after the next completed pass */
     kfwc_u64 mb_sig_pa;             /* last mailbox signature seen while searching */
     kfwc_u32 mb_sig_status, mb_sig_seen;
+    kfwc_u64 tw_last, tw_pair;      /* mbx-trace variant */
+    kfwc_u32 tw_seen;
     kfwc_u32 range_idx;
     kfwc_u64 range_off;
     kfwc_u32 steps_since_map_check;
