+/// REVIEW: Pointer mode forwards a SYNC_WAIT entry and then an entry that ends inside an open packet; the
+/// registration arrives; the guest publishes the packet's tail after the reply. The seeded gate authors
+/// barrier + marker at the Fresh boundary, which is inside the open packet on the hardware's view.
+#[test]
+fn review_seeded_marker_lands_inside_an_open_packet() {
+    let script = vec![
+        Op::Push(ge(0, Kind::SetObj)),
+        Op::SetPut,
+        Op::Ring,
+        Op::Push(p(1).sync()),
+        Op::Push(ge(2, Kind::OpenHead)),
+        Op::SetPut,
+        Op::Ring,
+        Op::Register,
+        Op::AwaitReply,
+        Op::Push(ge(3, Kind::OpenTail).post()),
+        Op::Push(p(4).post()),
+        Op::SetPut,
+        Op::Ring,
+    ];
+    let mut cfg = Cfg::new(spec(script, &[0, 1, 2, 3, 4]));
+    cfg.kind = Registration::Other;
+    let r = explore(&cfg);
+    println!("review: {} states viol={:?} first={:?}", r.states, viol_names(r.viol), r.first);
+    assert!(r.viol & V_MARKER_IN_PACKET != 0, "expected the seeded marker inside the packet");
+}
