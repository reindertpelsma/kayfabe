+/// REVIEW: a1 with the SYNC_WAIT as a LENGTH-0 control entry (the Edge / Win11 shape).
+#[test]
+fn review_a1_with_a_length0_sync_wait() {
+    let script = vec![
+        Op::Push(ge(0, Kind::SetObj)),
+        Op::SetPut,
+        Op::Ring,
+        Op::Push(p(1).acq(0)),
+        Op::Push(ge(2, Kind::Nop).sync()),
+        Op::SetPut,
+        Op::Ring,
+        Op::Register,
+        Op::AwaitReply,
+        Op::Push(p(3).late().post()),
+        Op::SetPut,
+        Op::Ring,
+        Op::Fill(3),
+        Op::Release(0),
+    ];
+    let mut cfg = Cfg::new(spec(script, &[0, 1, 2, 3]));
+    cfg.kind = Registration::Other;
+    let r = explore(&cfg);
+    println!("review-len0: {} states viol={:?}", r.states, viol_names(r.viol));
+    assert_eq!(r.viol, 0);
+}
