[
 "-name",
 "wakemsr-H-stock",
 "-machine",
 "q35,accel=kvm,smm=on",
 "-m",
 "1024",
 "-smp",
 "2,sockets=1,cores=2,threads=1",
 "-cpu",
 "host,-vmx,hv-relaxed,hv-vapic,hv-spinlocks=0x1fff,hv-time,hv-vpindex,hv-synic,hv-stimer,hv-crash,kvm=off",
 "-global",
 "ICH9-LPC.disable_s3=0",
 "-global",
 "ICH9-LPC.disable_s4=1",
 "-rtc",
 "base=utc",
 "-global",
 "kvm-pit.lost_tick_policy=discard",
 "-drive",
 "file=/root/wakerun/H-stock/overlay.qcow2,if=virtio,format=qcow2",
 "-drive",
 "file=/root/w/cidata.iso,if=virtio,format=raw,readonly=on",
 "-netdev",
 "user,id=n0,hostfwd=tcp:127.0.0.1:10022-:22",
 "-device",
 "virtio-net-pci,netdev=n0",
 "-qmp",
 "unix:/root/wakerun/H-stock/qmp.sock,server=on,wait=off",
 "-serial",
 "file:/root/wout/H-stock/serial.log",
 "-display",
 "none",
 "-vga",
 "std",
 "-trace",
 "system_wakeup_request",
 "-global",
 "driver=cfi.pflash01,property=secure,value=on",
 "-drive",
 "if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
 "-drive",
 "if=pflash,format=raw,unit=1,file=/root/wakerun/H-stock/OVMF_VARS.fd"
]