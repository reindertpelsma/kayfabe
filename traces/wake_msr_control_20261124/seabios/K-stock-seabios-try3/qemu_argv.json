[
 "-name",
 "wakemsr-K-stock",
 "-machine",
 "q35,accel=kvm,smm=on",
 "-m",
 "1024",
 "-smp",
 "2,sockets=1,cores=2,threads=1",
 "-cpu",
 "host,-vmx,hv-relaxed,hv-vapic,hv-spinlocks=0x1fff,hv-time,hv-vpindex,hv-synic,hv-stimer,hv-crash",
 "-global",
 "ICH9-LPC.disable_s3=0",
 "-global",
 "ICH9-LPC.disable_s4=1",
 "-rtc",
 "base=utc",
 "-global",
 "kvm-pit.lost_tick_policy=discard",
 "-drive",
 "file=/root/wakerun/K-stock/overlay.qcow2,if=virtio,format=qcow2",
 "-drive",
 "file=/root/w/cidata.iso,if=virtio,format=raw,readonly=on",
 "-netdev",
 "user,id=n0,hostfwd=tcp:127.0.0.1:10022-:22",
 "-device",
 "virtio-net-pci,netdev=n0",
 "-qmp",
 "unix:/root/wakerun/K-stock/qmp.sock,server=on,wait=off",
 "-serial",
 "file:/root/wout/K-stock/serial.log",
 "-display",
 "none",
 "-vga",
 "std",
 "-trace",
 "system_wakeup_request"
]