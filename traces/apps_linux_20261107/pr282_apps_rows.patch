     }
 
 
+APPS = ["nvidia_smi", "deviceQuery", "vectorAdd", "torch_correct"]
+
+
+def app_lines(failing=(), unrun=(), names=APPS):
+    out = ["APPS_STAGE_LIST n=%d budget_s=3000 per_boot=100" % len(names)]
+    for n in names:
+        r = "FAIL" if n in failing else "NOT_RUN" if n in unrun else "PASS"
+        out.append("APP_ROW name=%s os=linux result=%s secs=%s guest_xid=0 note=%s"
+                   % (n, r, "-" if r == "NOT_RUN" else "7", "no result row" if r == "NOT_RUN" else "-"))
+    return out
+
+
+class AppsRows(unittest.TestCase):
+    """The apps stage (disabled by default in vast_payload.py): its APP_ROW lines become apps[] and
+    tests[] rows of the Linux guest subrun, and nothing else invents them."""
+
+    BASE = [("provision", 1, 0, 0), ("gates", 9, 0, 0), ("kf3_build", 1, 0, 0), ("raw_suite", 30, 0, 0),
+            ("thin_suite", 30, 0, 0), ("birth_census", 1, 0, 0), ("cuda_host", 4, 0, 0),
+            ("cuda_fat", 4, 0, 0)]
+
+    def doc(self, rows=(), lines=(), windows=False):
+        return rr.build_report(log_lines(windows=windows) + list(lines), result(windows=windows, rows=self.BASE + list(rows)))
+
+    def test_the_rows_belong_to_the_linux_guest_subrun(self):
+        d = self.doc([("apps", 4, 0, 0)], app_lines())
+        self.assertEqual(len(d["apps"]), 4)
+        self.assertEqual({a["sub"] for a in d["apps"]}, {"linux-580.159.03"})
+        self.assertEqual(d["apps"][0], {"sub": "linux-580.159.03", "name": "nvidia_smi", "os": "linux", "result": "PASS", "note": "-"})
+        mine = [t for t in d["tests"] if t["suite"] == "apps_linux"]
+        self.assertEqual([t["name"] for t in mine], APPS)
+        self.assertEqual({t["sub"] for t in mine}, {"linux-580.159.03"})
+        self.assertEqual(mine[0]["ms"], 7000)
+        linux = [s for s in d["subruns"] if s["os"] == "linux"][0]
+        self.assertEqual((linux["verdict"], linux["counts"]["pass"]), ("PASS", 35 + 4))
+
+    def test_no_apps_stage_no_rows(self):
+        d = self.doc()
+        self.assertEqual(d["apps"], [])
+        self.assertEqual([t for t in d["tests"] if t["suite"] == "apps_linux"], [])
+
+    def test_a_failing_gate_app_fails_the_linux_subrun_and_is_a_fail_row(self):
+        d = self.doc([("apps_passed", 3, 0, 0), ("apps", 0, 1, 0)], app_lines(failing=["vectorAdd"]))
+        self.assertEqual([a["result"] for a in d["apps"]], ["PASS", "PASS", "FAIL", "PASS"])
+        linux = [s for s in d["subruns"] if s["os"] == "linux"][0]
+        self.assertEqual(linux["verdict"], "FAIL")
+
+    def test_an_apps_retry_is_a_retry_not_a_failure_of_the_guest(self):
+        d = self.doc([("apps_retry_time", 0, 1, 0)], app_lines(unrun=["vectorAdd", "torch_correct"]))
+        self.assertEqual([a["result"] for a in d["apps"]], ["PASS", "PASS", "NOT_RUN", "NOT_RUN"])
+        linux = [s for s in d["subruns"] if s["os"] == "linux"][0]
+        self.assertEqual(linux["verdict"], "RETRY")
+
+    def test_a_real_failure_beside_an_apps_retry_stays_a_failure(self):
+        d = self.doc([("apps_retry_time", 0, 1, 0), ("thin_suite_x", 0, 1, 0)], app_lines())
+        self.assertEqual([s for s in d["subruns"] if s["os"] == "linux"][0]["verdict"], "FAIL")
+
+    def only_good(self, bad_line):
+        good = "APP_ROW name=good os=linux result=PASS secs=3 guest_xid=0 note=-"
+        d = self.doc([("apps", 1, 0, 0)], [bad_line, good])
+        self.assertEqual([a["name"] for a in d["apps"]], ["good"], bad_line)
+        self.assertEqual([t["name"] for t in d["tests"] if t["suite"] == "apps_linux"], ["good"])
+
+    def test_a_name_with_a_path_is_not_a_row(self):
+        self.only_good("APP_ROW name=../etc os=linux result=PASS secs=1 guest_xid=0 note=x")
+
+    def test_a_name_with_a_shell_character_is_not_a_row(self):
+        self.only_good("APP_ROW name=a;b os=linux result=PASS secs=1 guest_xid=0 note=x")
+
+    def test_a_name_of_49_characters_is_not_a_row(self):
+        self.only_good("APP_ROW name=" + "a" * 49 + " os=linux result=PASS secs=1 guest_xid=0 note=x")
+
+    def test_a_name_of_200_characters_is_not_a_row(self):
+        self.only_good("APP_ROW name=" + "b" * 200 + " os=linux result=PASS secs=1 guest_xid=0 note=x")
+
+    def test_a_windows_app_row_is_not_a_linux_row(self):
+        self.only_good("APP_ROW name=w1 os=windows result=PASS secs=1 guest_xid=0 note=x")
+
+    def test_an_unknown_os_is_not_a_linux_row(self):
+        self.only_good("APP_ROW name=w2 os=macos result=PASS secs=1 guest_xid=0 note=x")
+
+    def test_a_result_outside_the_three_is_not_a_row(self):
+        self.only_good("APP_ROW name=m1 os=linux result=MAYBE secs=1 guest_xid=0 note=x")
+
+    def test_a_timeout_word_is_not_an_app_result(self):
+        self.only_good("APP_ROW name=m2 os=linux result=TIMEOUT secs=1 guest_xid=0 note=x")
+
+    def test_a_scientific_duration_is_not_a_row(self):
+        self.only_good("APP_ROW name=m3 os=linux result=PASS secs=1e9 guest_xid=0 note=x")
+
+    def test_a_word_for_a_duration_is_not_a_row(self):
+        self.only_good("APP_ROW name=m4 os=linux result=PASS secs=soon guest_xid=0 note=x")
+
+    def test_a_500_character_note_is_cut_to_200(self):
+        d = self.doc([("apps", 1, 0, 0)], ["APP_ROW name=good os=linux result=PASS secs=3 guest_xid=0 note=" + "n" * 500])
+        self.assertEqual(len(d["apps"][0]["note"]), 200)
+
+    def test_a_201_character_note_is_cut_to_200(self):
+        d = self.doc([("apps", 1, 0, 0)], ["APP_ROW name=good os=linux result=PASS secs=3 guest_xid=0 note=" + "n" * 201])
+        self.assertEqual(len(d["apps"][0]["note"]), 200)
+
+    def test_every_apps_row_names_a_subrun_of_this_report(self):
+        d = self.doc([("apps", 4, 0, 0)], app_lines())
+        subs = {s["sub"] for s in d["subruns"]}
+        self.assertTrue(all(r["sub"] in subs for r in d["apps"] + d["tests"]))
+        self.assertEqual({r["sub"] for r in d["apps"]}, {"linux-580.159.03"})
+
+    def test_a_missing_bundle_retry_without_any_app_row_is_a_retry_subrun(self):
+        d = self.doc([("apps_retry_not_built", 0, 1, 0)], ["APPS_STAGE_RETRY class=NOT_BUILT"])
+        self.assertEqual(d["apps"], [])
+        self.assertEqual([s for s in d["subruns"] if s["os"] == "linux"][0]["verdict"], "RETRY")
+
+    def test_duplicates_keep_the_last_row_and_the_cap_holds(self):
+        d = self.doc([("apps", 2, 0, 0)], app_lines(names=["a1"]) + app_lines(failing=["a1"], names=["a1"]))
+        self.assertEqual([a["result"] for a in d["apps"]], ["FAIL"])
+        many = ["APP_ROW name=app%d os=linux result=PASS secs=1 guest_xid=0 note=-" % i for i in range(700)]
+        self.assertEqual(len(self.doc([("apps", 700, 0, 0)], many)["apps"]), rr.LIMITS["apps"])
+
+    def test_an_app_row_never_carries_a_token_shape_or_a_score_into_the_report(self):
+        d = self.doc([("apps", 4, 0, 0)], app_lines())
+        self.assertNotIn(TOKEN, json.dumps(d))
+        self.assertNotIn("score", json.dumps(d["apps"]))
+
+
 class Build(unittest.TestCase):
