+// Q4 TEST HELPER ONLY: encode the public root-allocation request, not a product change.
+fn q4_probe_root_params(
+    v: kf_abi::DriverVersion,
+    client: u32,
+    pid: u32,
+) -> Result<Vec<u8>, RmError> {
+    let l = kf_abi::matrix::Resolved::of(&kf_abi::generated::matrix::NV0000_ALLOC_PARAMETERS, v)
+        .map_err(|_| RmError::Other(ABI_ENCODE_FAILED))?;
+    let mut p = vec![0; l.size()];
+    // Q4_FIELDS_BEGIN
+    for (name, value) in [("hClient", client), ("processID", pid)] {
+        let at = l
+            .need(name)
+            .map_err(|_| RmError::Other(ABI_ENCODE_FAILED))?
+            .off();
+        p[at..at + 4].copy_from_slice(&value.to_le_bytes());
+    }
+    // Q4_FIELDS_END
+    Ok(p)
+}
+#[cfg(test)]
+mod q4_probe_tests {
+    use super::*;
+    fn v() -> kf_abi::DriverVersion {
+        kf_abi::DriverVersion::parse("595.84").unwrap()
+    }
+    #[test]
+    fn q4_probe_chosen_client_is_carried_in_root_params() {
+        let p = q4_probe_root_params(v(), 0xc1e0_0100, 1234).unwrap();
+        let facts = kf_abi::versions::table_for(v())
+            .unwrap()
+            .decode_client_alloc_facts(&p)
+            .unwrap();
+        assert_eq!(facts.h_client, 0xc1e0_0100);
+    }
+    #[test]
+    fn q4_probe_userspace_pid_is_carried_independently() {
+        let p = q4_probe_root_params(v(), 0xc1e0_0100, 1234).unwrap();
+        let facts = kf_abi::versions::table_for(v())
+            .unwrap()
+            .decode_client_alloc_facts(&p)
+            .unwrap();
+        assert_eq!(facts.process_id, 1234);
+    }
+    #[test]
+    fn q4_probe_full_ioctl_layout_keeps_os_pointer_clear() {
+        let p = q4_probe_root_params(v(), 0xc1e0_0100, 1234).unwrap();
+        assert_eq!(p.len(), 120);
+        assert!(p[8..].iter().all(|b| *b == 0));
+    }
+}
