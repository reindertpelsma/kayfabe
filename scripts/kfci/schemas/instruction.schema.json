{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kayfabe.dev/schemas/kfci/v1/instruction.schema.json",
  "title": "kayfabe box payload instruction version 1",
  "$comment": "STATUS 2026-11-15: LIVE (scripts/ci/payload_instruction.py reads it). Mirror: scripts/kfci/schemas/instruction.schema.json must be byte-identical (test_payload_instruction.py). Instruction = what a box runs; a requirement (what is wanted) is a different format that the Worker resolves into this. 2026-11-16: optional `propimages` = the images and apps of the generic proprietary-image runner (scripts/bench/windows/propimage_runspec.py validates the same objects; docs/design/V3_PROPIMAGE_RUNNER.md). 2026-11-17: optional `matlab` = the MATLAB GPU rows of the Linux proprietary image (scripts/bench/linux/matlab_rows.py, stage `matlab` of scripts/ci/vast_payload.py; docs/design/V3_PROPIMAGE_LINUX.md section 14). Always strict: the image is a pin, the rows list is the Worker's. 2026-11-18: optional `matlab.bin` = where the image keeps the matlab binary in the guest (an image property, from ci/vast-broker/propimages.json `linux_images[].bin`); the rows' own pattern, at most 120 characters of letters, digits and `_ . / -`; absent = the name `matlab`.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kayfabe.payload-instruction/1"
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tier": {
      "enum": [
        "small",
        "middle",
        "large",
        "adhoc",
        "unknown"
      ]
    },
    "windows": {
      "type": "boolean"
    },
    "windows_runs": {
      "enum": [
        1,
        2
      ]
    },
    "stages": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "specviewperf"
        ]
      }
    },
    "spec": {
      "enum": [
        "lanea",
        "laneb",
        "both",
        null
      ]
    },
    "winapps": {
      "enum": [
        "small",
        "mid",
        "full",
        null
      ]
    },
    "linux_apps": {
      "enum": [
        "middle",
        "large",
        null
      ]
    },
    "rehearsal": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "propimages": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/propimage"
      }
    },
    "propimages_strict": {
      "type": "boolean"
    },
    "matlab": {
      "$ref": "#/$defs/matlab"
    }
  },
  "required": [
    "schema",
    "tier",
    "windows",
    "windows_runs",
    "stages",
    "spec",
    "winapps",
    "linux_apps",
    "rehearsal"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "from": {
          "enum": [
            "official",
            "file",
            "url",
            "pin"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[ -~]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false
    },
    "propimage_app": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "present",
            "skip",
            "install"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "lane": {
          "enum": [
            "gate",
            "discovery"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "propimage": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "prebuilt",
            "built"
          ]
        },
        "disk": {
          "$ref": "#/$defs/source"
        },
        "iso": {
          "$ref": "#/$defs/source"
        },
        "state": {
          "enum": [
            "auto",
            "none"
          ]
        },
        "state_file": {
          "$ref": "#/$defs/source"
        },
        "net": {
          "enum": [
            "off",
            "on"
          ]
        },
        "only": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          }
        },
        "apps": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/propimage_app"
          }
        },
        "ssh": {
          "type": "object",
          "properties": {
            "user": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "key_file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[ -~]+$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": [
            "user",
            "key_file"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "matlab": {
      "type": "object",
      "properties": {
        "bin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "image": {
          "type": "object",
          "properties": {
            "from": {
              "enum": [
                "pin"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "from",
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        "driver": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 3,
              "maxLength": 16,
              "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
            }
          },
          "required": [
            "version"
          ],
          "additionalProperties": false
        },
        "rows": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "$ref": "#/$defs/matlab_row"
          }
        },
        "isolation": {
          "enum": [
            "row",
            "shared"
          ]
        }
      },
      "required": [
        "image",
        "driver",
        "rows"
      ],
      "additionalProperties": false
    },
    "matlab_row": {
      "type": "object",
      "properties": {
        "lane": {
          "enum": [
            "gate",
            "discovery"
          ]
        }
      },
      "required": [
        "lane"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "name",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
