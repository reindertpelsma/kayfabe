#!/bin/sh
# Resolve a private release locator using only this run's scoped capability.
set -eu
env_file=${KF_CI_ENV_FILE:-/run/kf-ci/env}
# shellcheck disable=SC1090
. "$env_file"
[ "$#" -eq 2 ] || exit 2
for value in "$1" "$2"; do
    case "$value" in ''|.|..|*[!A-Za-z0-9._-]*) exit 2;; esac
done
[ "${#1}" -le 64 ] && [ "${#2}" -le 100 ] || exit 2
case ${KF_RUN_TOKEN:-} in ''|*[!A-Za-z0-9._-]*) exit 2;; esac
printf 'header = "Authorization: Bearer %s"\n' "$KF_RUN_TOKEN" |
    curl --config - --silent --show-error --fail --max-time 20 --max-redirs 0 --proto '=https' \
        --noproxy '*' "${KF_BROKER_URL:?}/blob-url/${KF_RUN_ID:?}/$1/$2"
