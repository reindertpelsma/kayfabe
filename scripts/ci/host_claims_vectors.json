{
  "note": "Shared vectors: ci/vast-broker/src/results.js cleanClaims and scripts/ci/vast_report.py clean_claims must give the same answer. Input (any JSON value) -> the cleaned object; keys not listed in 'expect' are null.",
  "cases": [
    {"name": "typical AMD box", "input": {"cpu_vendor": "amd", "cpu_model": "AMD EPYC 7763 64-Core Processor", "cpu_arch": "x86_64", "linux_os_version": "ubuntu-24.04", "linux_driver": "580.159.04", "windows_os_version": "11-ltsc-2024-26100", "windows_driver": "580.88", "host_driver": "580.95.05"},
     "expect": {"cpu_vendor": "amd", "cpu_model": "AMD EPYC 7763 64-Core Processor", "cpu_arch": "x86_64", "linux_os_version": "ubuntu-24.04", "linux_driver": "580.159.04", "windows_os_version": "11-ltsc-2024-26100", "windows_driver": "580.88", "host_driver": "580.95.05"}},
    {"name": "intel model with parentheses and clock", "input": {"cpu_vendor": "intel", "cpu_model": "Intel(R) Xeon(R) Gold 6338 CPU @ 2.00GHz"},
     "expect": {"cpu_vendor": "intel", "cpu_model": "Intel(R) Xeon(R) Gold 6338 CPU @ 2.00GHz"}},
    {"name": "whitespace is collapsed", "input": {"cpu_model": "  AMD   Ryzen 9\t7950X  "}, "expect": {"cpu_model": "AMD Ryzen 9 7950X"}},
    {"name": "arm and aarch64", "input": {"cpu_vendor": "arm", "cpu_arch": "aarch64"}, "expect": {"cpu_vendor": "arm", "cpu_arch": "aarch64"}},
    {"name": "unknown vendor and arch are dropped", "input": {"cpu_vendor": "via", "cpu_arch": "riscv64"}, "expect": {}},
    {"name": "vendor is case sensitive", "input": {"cpu_vendor": "AMD", "cpu_arch": "X86_64"}, "expect": {}},
    {"name": "drivers: valid shapes", "input": {"host_driver": "570.172.08", "linux_driver": "580.159.04", "windows_driver": "580.88"},
     "expect": {"host_driver": "570.172.08", "linux_driver": "580.159.04", "windows_driver": "580.88"}},
    {"name": "drivers: invalid shapes", "input": {"host_driver": "unknown", "linux_driver": "58.1", "windows_driver": "580.88.1.2"}, "expect": {}},
    {"name": "driver with trailing newline", "input": {"linux_driver": "580.88\n"}, "expect": {}},
    {"name": "uuid in model", "input": {"cpu_model": "GPU-3b1c9d2e-1111-2222-3333-444455556666"}, "expect": {}},
    {"name": "long hex run in model (serial)", "input": {"cpu_model": "Xeon 0123456789abcdef"}, "expect": {}},
    {"name": "ipv4 in model", "input": {"cpu_model": "Xeon 10.1.2.3"}, "expect": {}},
    {"name": "url in model", "input": {"cpu_model": "Xeon http://x.example/a"}, "expect": {}},
    {"name": "address with host part in model", "input": {"cpu_model": "root@box.example"}, "expect": {}},
    {"name": "token shape in os version", "input": {"linux_os_version": "eyJhbGciOiJIUzI1NiJ9"}, "expect": {}},
    {"name": "model too long", "input": {"cpu_model": "Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon"}, "expect": {}},
    {"name": "model 64 characters", "input": {"cpu_model": "Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon"}, "expect": {"cpu_model": "Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon Xeon"}},
    {"name": "model with control character", "input": {"cpu_model": "Xeon\u0007bell"}, "expect": {}},
    {"name": "model with shell metacharacters", "input": {"cpu_model": "Xeon; rm -rf /"}, "expect": {}},
    {"name": "os version too long", "input": {"linux_os_version": "ubuntu-24.04-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}, "expect": {}},
    {"name": "os version uppercase refused", "input": {"windows_os_version": "Windows 11"}, "expect": {}},
    {"name": "wrong types", "input": {"cpu_vendor": 1, "cpu_model": ["AMD"], "linux_driver": 580, "windows_os_version": null}, "expect": {}},
    {"name": "unknown keys are dropped", "input": {"machine_id": "123456", "hostname": "box1", "cpu_vendor": "amd"}, "expect": {"cpu_vendor": "amd"}},
    {"name": "not an object: array", "input": ["amd"], "expect": {}},
    {"name": "not an object: string", "input": "amd", "expect": {}},
    {"name": "not an object: null", "input": null, "expect": {}},
    {"name": "not an object: number", "input": 5, "expect": {}}
  ]
}
