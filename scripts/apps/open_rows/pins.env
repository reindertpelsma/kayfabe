# STATUS: LIVE, 2026-11-17. Inputs of the open FFmpeg/DCGM rows (docs/design/V3_OPEN_ROWS_FFMPEG_DCGM.md section 3 names the trust anchor of each).
# Data only, sourced by provision.sh. Owner rule 2026-11-17: no sha256 of a downloaded binary is pinned in git. What is pinned here is a
# source commit (anchor: the upstream git history), an exact package VERSION string (not a hash), and URLs of the upstream's own origin.
#
# nvcodec_probe.c headers: nv-codec-headers (MIT), a source input pinned by upstream tag AND full commit (pin_lib.sh checks HEAD == commit).
OPENROWS_NVCH_URL=https://github.com/FFmpeg/nv-codec-headers.git
OPENROWS_NVCH_TAG=n12.2.72.0
OPENROWS_NVCH_COMMIT=c69278340ab1d5559c7d7bf0edf615dc33ddbba7
# DCGM: NVIDIA's own apt repository. The repository key is fetched at run time from NVIDIA's official URL (the same origin as the packages,
# over https) and installed as the repository's signed-by key; apt then verifies the signed index. Pinned: the exact version string, which
# apt resolves (every DCGM 4 package depends on the same `= version` of its siblings). CUDA 12 flavour: it runs on any driver that
# supports CUDA 12 or newer.
OPENROWS_NVIDIA_REPO_BASE=https://developer.download.nvidia.com/compute/cuda/repos
OPENROWS_NVIDIA_KEY_FILE=3bf863cc.pub
# the key's full fingerprint, MEASURED 2026-11-19 from the file above; its low 64 bits A4B469963BF863CC are the key id NVIDIA publishes
# (developer.nvidia.com/blog/updating-the-cuda-linux-gpg-repository-key). provision.sh refuses any other key.
OPENROWS_NVIDIA_KEY_FPR=EB693B3035CD5710E231E123A4B469963BF863CC
OPENROWS_DCGM_VERSION=1:4.8.0-1
OPENROWS_DCGM_PACKAGE_STEMS="datacenter-gpu-manager-4-cuda datacenter-gpu-manager-4-proprietary-cuda"

# --- the open lanes of docs/design/V3_OPEN_LANES_NVBW_LLAMAVK_LHM.md (provision.sh steps nvbandwidth and llama_vulkan) -------------------------------------------
# nvbandwidth (Apache-2.0): a SOURCE input pinned by upstream tag AND full commit (pin_lib.sh checks HEAD == commit). v0.9 is the release before the TMA and fabric
# kernels of v0.10/v0.11 (its code reads __CUDA_ARCH__ >= 900 only for sm_90 paths); the architectures are listed explicitly, the last one with PTX.
OPENROWS_NVB_URL=https://github.com/NVIDIA/nvbandwidth.git
OPENROWS_NVB_TAG=v0.9
OPENROWS_NVB_COMMIT=4a49bdae82d69e69330a88746cb12b449796ee8b
OPENROWS_NVB_ARCHS="75;80;86;89;90"
# llama.cpp with Vulkan: the pin is PIN_LLAMA_URL / PIN_LLAMA_COMMIT of ../pins.sh (the CUDA rows' commit). glslc (which ggml-vulkan compiles its shaders with) and the
# Vulkan headers come from the distribution's signed archive when it has them (Ubuntu 24.04), else from the LunarG Vulkan SDK of this version: its sha256 is the one LunarG
# lists for that version at run time (an official-origin checksum, not a digest in git).
OPENROWS_LUNARG_SDK_VERSION=1.4.341.1
OPENROWS_LUNARG_SDK_BASE=https://sdk.lunarg.com/sdk/download
OPENROWS_LUNARG_CHECKSUM_BASE=https://vulkan.lunarg.com/sdk/sha
