 "rows": {
  "vkglcts_gl46": {
   "group": "cts",
   "kind": "cts-gl",
   "binary": "glcts",
   "caselist": "caselists/gl46_core.txt",
   "args": [
    "--deqp-gl-context-type=wgl",
    "--deqp-gl-config-name=rgba8888d24s8",
    "--deqp-surface-width=64",
    "--deqp-surface-height=64",
    "--deqp-visibility=windowed",
    "--deqp-log-images=disable",
    "--deqp-log-shader-sources=disable",
    "--deqp-crashhandler=enable",
    "--deqp-watchdog=enable",
    "--deqp-watchdog-total-time-limit=600"
   ],
   "chunk": 25,
   "case_timeout_s": 600,
   "interactive": true,
   "chunk_timeout_s": 1800
  },
  "vkglcts_vk": {
   "group": "cts",
   "kind": "cts-vk",
   "binary": "deqp-vk",
   "caselist": "caselists/vk_breadth.txt",
   "args": [
    "--deqp-log-images=disable",
    "--deqp-log-shader-sources=disable",
    "--deqp-crashhandler=enable",
    "--deqp-terminate-on-device-lost=enable",
    "--deqp-watchdog=enable",
    "--deqp-watchdog-total-time-limit=600"
   ],
   "chunk": 20,
   "case_timeout_s": 600,
   "interactive": false,
   "chunk_timeout_s": 1800
  },
  "vkglcts_gl_dual_soak": {
   "group": "cts",
   "kind": "gl-soak",
   "seconds": 600,
   "seconds_smoke": 60,
   "interactive": true,
   "crash_signatures": [
    "nvoglv64.dll",
    "nvlddmkm:153"
   ]
  },
  "dxsamples_nbody_async": {
   "group": "dxs",
   "kind": "dx-window",
   "sample": "nbody",
   "seconds": 40,
   "frames_advance": true,
   "keys": [],
   "engines_all": [
    "3D",
    "Compute"
   ]
  },
  "dxsamples_execute_indirect": {
   "group": "dxs",
   "kind": "dx-window",
   "sample": "execute_indirect",
   "seconds": 40,
   "frames_advance": true,
   "keys": [
    {
     "vk": "SPACE"
    },
    {
     "vk": "SPACE"
    }
   ],
   "engines_all": [
    "3D",
    "Compute"
   ]
  },
  "dxsamples_reserved_resources": {
   "group": "dxs",
   "kind": "dx-window",
   "sample": "reserved_resources",
   "seconds": 40,
   "frames_advance": false,
   "title_regex": "Mip Level: (\\d+)",
   "keys": [
    {
     "vk": "UP",
     "repeat": 8
    },
    {
     "vk": "DOWN",
     "repeat": 8
    },
    {
     "vk": "UP",
     "repeat": 4
    },
    {
     "vk": "DOWN",
     "repeat": 4
    }
   ],
   "engines_any": [
    "3D"
   ]
  },
  "dxsamples_hdr": {
   "group": "dxs",
   "kind": "dx-window",
   "sample": "hdr",
   "seconds": 40,
   "frames_advance": false,
   "optional": true,
   "keys": [
    {
     "vk": "PRIOR"
    },
    {
     "vk": "PRIOR"
    },
    {
     "vk": "NEXT"
    },
    {
     "vk": "NEXT"
    },
    {
     "vk": "H"
    },
    {
     "vk": "H"
    }
   ],
   "engines_any": [
    "3D"
   ]
  },
  "dxsamples_work_graphs": {
   "group": "dxs",
   "kind": "dx-console",
   "sample": "work_graphs",
   "timeout_s": 300,
   "ok_regex": "Execution complete",
   "uav_regex": "UAV\\[(\\d+)\\] = 0x([0-9a-fA-F]+)",
   "uav_lines": 8,
   "not_supported_regex": "does not report support for work graphs",
   "engines_any": [
    "3D",
    "Compute"
   ]
  },
  "dxsamples_multiadapter": {
   "group": "dxs",
   "kind": "not-run",
   "reason": "needs-two-gpus",
   "detail": "D3D12HeterogeneousMultiadapter and D3D12LinkedGpus (both in the pinned tree) need two GPUs or two adapters; a kayfabe guest has one"
  },
  "hwmon_lhm_nvapi": {
   "group": "hwmon",
   "kind": "hwmon",
   "tool": "lhm",
   "timeout_s": 300,
   "gpu_hardware_type": "GpuNvidia",
   "required_sensor_types": [
    "Temperature",
    "Clock",
    "Load",
    "SmallData"
   ],
   "temperature_c": [
    1,
    125
   ],
   "load_percent": [
    0,
    100
   ],
   "smi_tolerance": {
    "temperature_c": 15,
    "memory_fraction": 0.05
   },
   "negctl": "gpu-disabled",
   "matrix": {
    "state": "deferred",
    "reason": "apps.json is a hash-covered input of the published Windows apps bundle (appmatrix/bundle.pin, RECIPE_INPUT_DRIFT): a matrix row needs the coordinator's republish, so the row runs through kfopen.py until then",
    "row": {
     "id": "hwmon_lhm_nvapi",
     "category": "probe",
     "session": "service",
     "tier": 3,
     "timeout_s": 1800,
     "expect_s": 120,
     "rx": "^KFOPEN VERDICT PASS row=hwmon_lhm_nvapi sensors=\\d+ classes=\\d+$",
     "proof": [
      "out:KFOPEN HWMON gpu=NVIDIA"
     ],
     "smi": false
    }
   }
  }
 }
}
