  "reference": "https://learn.microsoft.com/en-us/nuget/reference/nuget-config-file#trustedsigners-section"
 },
 "cts_build": {
  "generator": "Visual Studio 17 2022",
  "arch": "x64",
  "config": "Release",
  "cmake_args": [
   "-DDEQP_TARGET=default",
   "-DDEQP_DISABLE_VK_VIDEO_TESTS=ON"
  ],
  "targets": {
