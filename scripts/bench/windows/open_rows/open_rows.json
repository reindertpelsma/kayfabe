{
 "schema": 1,
 "status": "STATUS: DESIGN-ONLY, 2026-11-17. Pins and definitions of the open Windows rows (VK-GL-CTS, DirectX-Graphics-Samples extras). Facts marked CHECKED in docs/design/V3_WINDOWS_OPEN_ROWS.md were read from the public upstream trees today; nothing here ran on hardware.",
 "trust": {
  "default": "git-only",
  "explanation": "A standalone run trusts git only: every third-party SOURCE is a clone of a pinned upstream commit, every prebuilt TOOL needs one of the accepted anchors below. Lifting is explicit (--accept-unanchored-downloads REASON, --source-commit-override NAME=SHA) and is written into the receipt. A path or URL the user passes explicitly (--tool NAME=PATH, --prebuilt DIR) is always trusted: its sha256 is recorded, nothing is verified.",
  "anchors": [
   "upstream-sha256: an official https checksum file or release-notes table fetched at run time from the upstream origin",
   "authenticode: the vendor's code signature on the file (Get-AuthenticodeSignature Status Valid, expected signer)",
   "pypi-sha256: the file digest in the PyPI JSON of the pinned version, enforced by pip --require-hashes",
   "nuget-signature: nuget.org repository signature, signatureValidationMode=require with the nuget.org certificate fingerprints of the NuGet docs",
   "ci-attestation: gh attestation verify of a CI-built artifact (pinned repo, workflow and source commit); NOT used by this PR, the plug-in point of a future cache",
   "git-commit: a pinned upstream commit, checked with git rev-parse HEAD after the clone (sources only)"
  ]
 },
 "sources": {
  "cts": {
   "repository": "https://github.com/KhronosGroup/VK-GL-CTS.git",
   "tag": "vulkan-cts-1.4.7.1",
   "commit": "0d18b347943e5e843529a05c95220e27fe30c538",
   "licence": "Apache-2.0",
   "anchor": "git-commit",
   "fetch_sources": "external/fetch_sources.py",
   "fetch_sources_note": "upstream's own script; its git revisions and archive sha256 values live in the pinned commit and are reviewed against upstream, not copied here"
  },
  "dxs": {
   "repository": "https://github.com/microsoft/DirectX-Graphics-Samples.git",
   "commit": "68a2b1e97f71642924e74c7757ca21756ad221b5",
   "licence": "MIT",
   "anchor": "git-commit",
   "same_pin_as": "release_software.json directx.commit",
   "filter": "blob:none",
   "sparse_from": "dxs_samples[*].checkout"
  }
 },
 "tools": {
  "git": {
   "purpose": "clone the pinned sources; CTS external/fetch_sources.py runs git",
   "kind": "mingit-zip",
   "anchor": "upstream-sha256",
   "release_tag": "v2.56.1.windows.1",
   "asset": "MinGit-2.56.1-64-bit.zip",
   "release_api": "https://api.github.com/repos/git-for-windows/git/releases/tags/v2.56.1.windows.1",
   "download_prefix": "https://github.com/git-for-windows/git/releases/download/v2.56.1.windows.1/"
  },
  "python": {
   "purpose": "CTS external/fetch_sources.py and gen_framework.py (needs pip and lxml, so the embeddable zip is not enough)",
   "kind": "installer-exe",
   "anchor": "authenticode",
   "url": "https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe",
   "signer": "Python Software Foundation",
   "install_args": [
    "/quiet",
    "InstallAllUsers=0",
    "Include_launcher=0",
    "Include_test=0",
    "Include_doc=0",
    "PrependPath=0",
    "Shortcuts=0",
    "TargetDir={dest}"
   ]
  },
  "lxml": {
   "purpose": "Vulkan CTS gen_framework.py (imports lxml)",
   "kind": "pip-wheel",
   "anchor": "pypi-sha256",
   "version": "6.1.3",
   "pypi_json": "https://pypi.org/pypi/lxml/6.1.3/json"
  },
  "msvc": {
   "purpose": "MSVC v143, MSBuild, Windows SDK and the CMake that ships with Visual Studio",
   "kind": "installer-exe",
   "anchor": "authenticode",
   "url": "https://aka.ms/vs/17/release/vs_BuildTools.exe",
   "signer": "Microsoft Corporation",
   "components": [
    "Microsoft.VisualStudio.Workload.VCTools",
    "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
    "Microsoft.VisualStudio.Component.VC.CMake.Project",
    "Microsoft.VisualStudio.Component.Windows11SDK.26100"
   ],
   "install_args": [
    "--quiet",
    "--wait",
    "--norestart",
    "--nocache",
    "--noUpdateInstaller",
    "--installPath",
    "{dest}"
   ],
   "ok_exit_codes": [
    0,
    3010
   ]
  },
  "nuget": {
   "purpose": "restore the packages.config of the DirectX samples (Agility SDK, DXC, PIX runtime)",
   "kind": "exe",
   "anchor": "authenticode",
   "url": "https://dist.nuget.org/win-x86-commandline/v7.9.0/nuget.exe",
   "signer": "Microsoft Corporation"
  },
  "lhm": {
   "purpose": "LibreHardwareMonitor (MPL-2.0): its library reads the NVIDIA GPU through NVAPI (nvapi64.dll of the driver); the release zip carries the library and every assembly it loads",
   "kind": "release-zip",
   "anchor": "upstream-sha256",
   "release_tag": "v0.9.6",
   "release_commit": "3d331e3370efb858411f19511373eff65a218701",
   "asset": "LibreHardwareMonitor.zip",
   "release_api": "https://api.github.com/repos/LibreHardwareMonitor/LibreHardwareMonitor/releases/tags/v0.9.6",
   "download_prefix": "https://github.com/LibreHardwareMonitor/LibreHardwareMonitor/releases/download/v0.9.6/",
   "licence": "MPL-2.0"
  }
 },
 "nuget_trust": {
  "source": "https://api.nuget.org/v3/index.json",
  "signature_validation_mode": "require",
  "repository_name": "nuget.org",
  "fingerprints_sha256": [
   "0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D",
   "5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4",
   "1F4B311D9ACC115C8DC8018B5A49E00FCE6DA8E2855F9F014CA6F34570BC482D"
