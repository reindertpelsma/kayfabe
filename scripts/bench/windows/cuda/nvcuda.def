; SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later
; The nvcuda.dll exports the CUDA ladder (cup2, cup3, cup8) calls, for an import library built with
; x86_64-w64-mingw32-dlltool (build_cup_win.sh). The driver installs nvcuda.dll; no toolkit needed.
LIBRARY nvcuda.dll
EXPORTS
  cuInit
  cuDriverGetVersion
  cuDeviceGet
  cuDeviceGetCount
  cuDeviceGetAttribute
  cuDeviceGetName
  cuDeviceTotalMem_v2
  cuCtxCreate_v2
  cuCtxSynchronize
  cuMemAlloc_v2
  cuMemcpyHtoD_v2
  cuMemcpyDtoH_v2
  cuMemsetD32_v2
  cuModuleLoadData
  cuModuleGetFunction
  cuLaunchKernel
  cuGetErrorString
