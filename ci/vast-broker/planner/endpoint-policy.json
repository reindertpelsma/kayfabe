{
  "version": 1,
  "policy": "Conservative public unicast only; mapped IPv4 uses the IPv4 rules. Shared, documentation and special-transition ranges are declined.",
  "sources": [
    "https://www.iana.org/assignments/iana-ipv4-special-registry/",
    "https://www.iana.org/assignments/iana-ipv6-special-registry/"
  ],
  "ipv4_deny": [
    "0.0.0.0/8",
    "10.0.0.0/8",
    "100.64.0.0/10",
    "127.0.0.0/8",
    "169.254.0.0/16",
    "172.16.0.0/12",
    "192.0.0.0/24",
    "192.0.2.0/24",
    "192.88.99.0/24",
    "192.168.0.0/16",
    "198.18.0.0/15",
    "198.51.100.0/24",
    "203.0.113.0/24",
    "224.0.0.0/4",
    "240.0.0.0/4"
  ],
  "ipv6_unicast": "2000::/3",
  "ipv6_deny": ["2001::/23", "2001:db8::/32", "2002::/16", "3fff::/20"]
}
