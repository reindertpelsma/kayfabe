{
  "_comment": "Golden wire fixture for custom hosts (docs/design/V3_CUSTOM_HOSTS.md). The Worker's validators (src/hosts.js validateDaemonFrame / validateServerFrame) accept every `valid` frame and refuse every `invalid` one; the daemon side copies this file. Frames use `type`; `v` is optional and must be 1.",
  "constants": {
    "canonical_repo": "https://github.com/reindertpelsma/kayfabe",
    "tree_key_regex": "^[0-9a-f]{64}$",
    "commit_regex": "^[0-9a-f]{40}$",
    "stage_names": [
      "provision",
      "cuda_host",
      "merge_bar",
      "cuda_guest",
      "apps",
      "windows_gate",
      "windows_apps",
      "specviewperf",
      "ladder"
    ],
    "compute_cap_example": "8.9",
    "pci_device_id_regex": "^[0-9a-f]{4}$",
    "seed_token_regex": "^[a-z0-9]{8}$",
    "probe_path": "/<token>/probe.txt",
    "probe_content": "kfseed-probe-v1\n",
    "deadline_field": "deadline_ms",
    "offer_id_regex": "^[0-9a-f]{16}$",
    "cmd_id_regex": "^[0-9a-f]{16}$",
    "upgrade_route": "/hosts/<box_id>/ws",
    "auth_header": "Authorization: Bearer <kfh_ token>",
    "close_codes": {
      "bad_token": 4401,
      "disabled": 4403,
      "heartbeat_timeout": 4408,
      "replaced_or_live_connection_exists": 4409
    }
  },
