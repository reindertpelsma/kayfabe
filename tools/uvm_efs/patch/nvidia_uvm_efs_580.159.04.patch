+// serviced nor fatal: it consumes its batch entry and stays pending in hardware
+// until its EFS owner resolves it (or the kernel's timeout cancels it).
+static void service_fault_batch_efs_diverted(uvm_fault_service_batch_context_t *batch_context,
+                                             NvU32 first_fault_index,
+                                             NvU32 *block_faults)
+{
+    uvm_fault_buffer_entry_t *current_entry = batch_context->ordered_fault_cache[first_fault_index];
+    const uvm_fault_buffer_entry_t *previous_entry = first_fault_index > 0 ?
+                                                       batch_context->ordered_fault_cache[first_fault_index - 1] : NULL;
