+// for the cancel, the VA space lock in read mode (it reads the GPU VA space's
+// PDB).
+NV_STATUS uvm_efs_hw_cancel_va_locked(uvm_fault_buffer_entry_t *entry)
+{
+    UVM_ASSERT(uvm_sem_is_locked(&entry->gpu->parent->isr.replayable_faults.service_lock));
+    UVM_ASSERT(entry->gpu->parent->fault_cancel_va_supported);
+
