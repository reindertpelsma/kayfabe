+
+NV_STATUS uvm_efs_hw_replay_locked(uvm_gpu_t *gpu)
+{
+    UVM_ASSERT(uvm_sem_is_locked(&gpu->parent->isr.replayable_faults.service_lock));
+
+    return push_replay_on_gpu(gpu, UVM_FAULT_REPLAY_TYPE_START, NULL);
+}
